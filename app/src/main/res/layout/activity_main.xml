<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp"
        android:gravity="center_horizontal">

        <!-- ═══════════════════════════════════════ -->
        <!-- TOP BAR: Title + Badge                  -->
        <!-- ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FORCE 5G"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12" />

                <View
                    android:layout_width="44dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/accent_primary" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="v1.0"
                android:textColor="@color/accent_blue"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ═══════════════════════════════════════ -->
        <!-- CARRIER STRIP: slim, informational      -->
        <!-- ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_rounded_bg"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="6dp">

            <!-- Status dot -->
            <View
                android:id="@+id/statusIndicator"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/circle_indicator" />

            <!-- Carrier name -->
            <TextView
                android:id="@+id/tvCarrierName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Detecting…"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:singleLine="true" />

            <!-- Signal strength bars -->
            <LinearLayout
                android:id="@+id/signalBarsContainer"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginEnd="10dp">

                <View
                    android:id="@+id/signalBar1"
                    android:layout_width="4dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/signal_bar_filled" />
                <View
                    android:id="@+id/signalBar2"
                    android:layout_width="4dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/signal_bar_filled" />
                <View
                    android:id="@+id/signalBar3"
                    android:layout_width="4dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="2dp"
                    android:background="@drawable/signal_bar_filled" />
                <View
                    android:id="@+id/signalBar4"
                    android:layout_width="4dp"
                    android:layout_height="16dp"
                    android:background="@drawable/signal_bar_empty" />
            </LinearLayout>

            <!-- Network badge -->
            <TextView
                android:id="@+id/tv5GBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_5g"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="LTE"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- Network type subtitle -->
        <TextView
            android:id="@+id/tvNetworkType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking connection…"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:paddingStart="4dp"
            android:layout_marginBottom="36dp" />

        <!-- ═══════════════════════════════════════ -->
        <!-- CENTER: The Hero Circle                 -->
        <!-- ═══════════════════════════════════════ -->
        <FrameLayout
            android:layout_width="216dp"
            android:layout_height="216dp"
            android:layout_gravity="center_horizontal">

            <!-- Outer ring (visible when 5G active) -->
            <View
                android:id="@+id/circleRing"
                android:layout_width="208dp"
                android:layout_height="208dp"
                android:layout_gravity="center"
                android:background="@drawable/brutal_circle_ring"
                android:visibility="invisible" />

            <!-- Offset shadow circle -->
            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:layout_marginStart="6dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/brutal_circle_shadow" />

            <!-- Main circular button -->
            <FrameLayout
                android:id="@+id/btnOpenRadioInfo"
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:layout_gravity="center"
                android:background="@drawable/brutal_circle_btn"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:translationX="-3dp"
                android:translationY="-3dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvCircleIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡"
                        android:textSize="32sp" />

                    <TextView
                        android:id="@+id/tvCircleLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FORCE"
                        android:textColor="@color/text_on_dark"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.15" />

                    <TextView
                        android:id="@+id/tvCircleSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5G"
                        android:textColor="@color/text_on_dark"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.2" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <!-- Status label under circle -->
        <TextView
            android:id="@+id/tvCircleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAP TO ENABLE NR-ONLY"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="40dp" />

        <!-- ═══════════════════════════════════════ -->
        <!-- BOTTOM ACTIONS: Speed Test + Info       -->
        <!-- ═══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <!-- Speed Test -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:id="@+id/btnSpeedTest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/card_rounded_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="↓↑"
                        android:textColor="@color/accent_blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SPEED TEST"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Band Info -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">

                <LinearLayout
                    android:id="@+id/btnDeviceInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:paddingHorizontal="10dp"
                    android:background="@drawable/card_rounded_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◉"
                        android:textColor="@color/accent_hot"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="BAND INFO"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.06"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Footer -->
        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:background="@color/text_muted"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="NO ADS · NO TRACKING · OPEN SOURCE"
            android:textColor="@color/text_muted"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:letterSpacing="0.08" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
